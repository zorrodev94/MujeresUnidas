<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keeps the already configured R1 secrets on the original development PC. -->
    <UserSecretsId>b5ba3a4a-3355-4bdc-bde1-b9696ec27096</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <!-- Resolves the vulnerable transitive 9.0.4 Pkcs package to a patched .NET 10 version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same source contracts, no fourth project and no copy/paste DTO drift. -->
    <Compile Include="..\Shared\Contracts\*.cs" Link="Models\Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
