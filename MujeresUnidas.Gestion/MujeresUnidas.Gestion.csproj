<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Resources\Images\MujeresUnidas.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="server-endpoint.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\Images\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Images\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same source contracts, no fourth project and no copy/paste DTO drift. -->
    <Compile Include="..\Shared\Contracts\*.cs" Link="Models\Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
